# ==============================================================================
# TC5061 Proyecto Integrador - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo con el nombre '.env':
#      cp .env.example .env
# 2. Configura los valores correspondientes a tu entorno local.
# 3. NUNCA subas el archivo '.env' con secretos o credenciales reales al repositorio.
#    El archivo '.env' está explícitamente ignorado en el .gitignore.
# ==============================================================================

# MLflow Tracking Configuration
# Servidor remoto o base de datos local SQLite para registro de ejecuciones y modelos
MLFLOW_TRACKING_URI=sqlite:///mlruns.db
MLFLOW_EXPERIMENT_NAME=mibici-equipo23-dev

# Credenciales y Autenticación de MLflow (opcional si el servidor requiere auth básica)
# MLFLOW_TRACKING_USERNAME=tu_usuario
# MLFLOW_TRACKING_PASSWORD=tu_contrasena_segura

# Almacenamiento Remoto de Datos (DVC / Google Cloud Storage)
# Ruta local al archivo de credenciales de la cuenta de servicio de GCP
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/segura/a/tu/service_account.json
# GCP_PROJECT_ID=tu-gcp-project-id

# Configuración de Logging y Entorno
LOG_LEVEL=INFO
APP_ENV=development
